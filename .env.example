# ── Site ──────────────────────────────────────────────────────────────
# Canonical production URL (no trailing slash). Used for canonical/OG/hreflang
# and to allow-list the contact form origin.
# While on the *.vercel.app URL: leave this EMPTY (falls back to the Vercel URL).
NEXT_PUBLIC_SITE_URL=

# Set to "true" only once the real domain is connected — otherwise every page
# is noindex and robots.txt blocks all crawlers (keeps *.vercel.app out of Google).
ALLOW_INDEXING=

# ── Contact form (Gmail SMTP) ────────────────────────────────────────
# App password, NOT your Gmail password — https://myaccount.google.com/apppasswords
email_from=you@gmail.com
email_password=your_16_char_app_password
# Where leads are delivered (defaults to the address in constant/profile.ts).
CONTACT_TO_EMAIL=contato@pedrotx.com.br

# WhatsApp click-to-chat — digits only, country + area code (empty = hidden)
NEXT_PUBLIC_WHATSAPP=5544999999999

# ── Analytics / paid traffic (all optional; features stay off if unset) ──
# GA4 measurement id — https://analytics.google.com
NEXT_PUBLIC_GA_ID=
# Google Ads tag id, e.g. AW-XXXXXXXXX
NEXT_PUBLIC_ADS_ID=
# Google Ads conversion "send_to" label, e.g. AW-XXXXXXXXX/AbC-D_efGhI
NEXT_PUBLIC_ADS_CONVERSION_LABEL=

# ── Contact form bot protection (Cloudflare Turnstile — optional) ──
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
