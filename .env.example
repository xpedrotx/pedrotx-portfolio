# All variables are optional. Each feature stays off until its keys are set.
# Copy to .env.local for development.

# ── Site ──────────────────────────────────────────────────────────────
# Canonical production URL, no trailing slash (e.g. https://pedrotx.com.br).
# Leave empty on the *.vercel.app deploy — it falls back to the Vercel URL.
NEXT_PUBLIC_SITE_URL=

# Set to "true" only when the real domain is connected. Otherwise every page is
# noindex and robots.txt blocks all crawlers.
ALLOW_INDEXING=

# ── Contact form (Resend) ────────────────────────────────────────────
# API key from https://resend.com/api-keys. pedrotx.com.br must be a
# verified sending domain on the account (Resend > Domains).
RESEND_API_KEY=
# Where leads are delivered (defaults to the address in constant/profile.ts).
CONTACT_TO_EMAIL=

# ── WhatsApp click-to-chat ───────────────────────────────────────────
# Digits only, country + area code (e.g. 5544999999999). Empty = button hidden.
NEXT_PUBLIC_WHATSAPP=

# ── Analytics / paid traffic ─────────────────────────────────────────
# GA4 measurement id (G-XXXXXXXXXX), from https://analytics.google.com
NEXT_PUBLIC_GA_ID=
# Google Ads tag id (AW-XXXXXXXXX)
NEXT_PUBLIC_ADS_ID=
# Google Ads conversion send_to label (AW-XXXXXXXXX/AbC-D_efGhI)
NEXT_PUBLIC_ADS_CONVERSION_LABEL=

# ── Contact form bot protection (Cloudflare Turnstile) ───────────────
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
